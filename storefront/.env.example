# Copie para .env.local (arquivo ignorado pelo Git) e preencha. NUNCA commite segredos.
# Guia completo: docs/Checkout_Mercado_Pago.md

# --- Mercado Pago -----------------------------------------------------------
# Chave pública: aparece no navegador (é feita para isso).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Access Token: SEGREDO, só no servidor. Em produção, configure no painel da Vercel, nunca no código.
MP_ACCESS_TOKEN=
# simulated (padrão): sem chamar o Mercado Pago e sem cobrança real. live: cria pagamentos REAIS.
MP_MODE=simulated
# Segredo da assinatura de webhooks (painel do Mercado Pago > Webhooks). Obrigatório com MP_MODE=live.
MP_WEBHOOK_SECRET=

# --- Frete ------------------------------------------------------------------
# Token de produção SuperFrete (web.superfrete.com → Integrações → Desenvolvedores).
SUPERFRETE_TOKEN=
# Base da API: produção https://api.superfrete.com | sandbox https://sandbox.superfrete.com
SUPERFRETE_API_BASE=https://api.superfrete.com
# Token Melhor Envio (OAuth). Usado como fallback quando SHIPPING_PROVIDER=auto.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_API_BASE=https://www.melhorenvio.com.br
# auto | superfrete | melhor_envio
SHIPPING_PROVIDER=auto
# CEP de origem (8 dígitos). Precisa ser válido nos Correios.
SHIPPING_ORIGIN_CEP=72501200
# Obrigatório nas duas APIs: nome do app + e-mail técnico.
SHIPPING_USER_AGENT=DinoBlack Games (dinoblackgamesbrasil@gmail.com)

# --- Banco ------------------------------------------------------------------
# Produção/staging: string de conexão do Postgres do Supabase (pooler, modo transação).
DATABASE_URL=
# Só desenvolvimento: Postgres em memória com migrations + seed fictício (supabase/).
# Para staging/produção, deixe vazio e preencha DATABASE_URL.
CHECKOUT_DB=

# --- Site -------------------------------------------------------------------
# Endereço público. Em produção deve começar com https:// para habilitar notificações do Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3110
# Protege /api/cron/expire-orders (cancela pedidos não pagos e devolve o estoque).
CRON_SECRET=
